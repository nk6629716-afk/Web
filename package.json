{
  "name": "relay-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:server": "npm --workspace=@relay/server run dev",
    "dev:web": "npm --workspace=@relay/web run dev",
    "build": "npm run build --workspaces",
    "test": "npm --workspace=@relay/engine test && npm --workspace=@relay/server test",
    "test:engine": "npm --workspace=@relay/engine test",
    "test:server": "npm --workspace=@relay/server test"
  },
  "keywords": [
    "relay",
    "workflow",
    "collaboration",
    "dag"
  ],
  "author": "",
  "license": "MIT"
}
